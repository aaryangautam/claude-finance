# Copy to .env. Never commit .env.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox            # sandbox | production

# One access token per linked Item, written by the Link page (`finance app`), never by hand.
# The key is PLAID_TOKEN_<label> for the label picked in the Link dropdown ([link] institutions in config.toml).
# PLAID_TOKEN_CHECKINGBANK=

# Provider tokens (optional), named by `token_env` etc. in each [providers.<name>] table of config.toml.
# Wise: a read-only personal API token, plus the RSA private key registered with Wise for SCA-protected statements.
# WISE_TOKEN=
# WISE_PRIVATE_KEY_PATH=
